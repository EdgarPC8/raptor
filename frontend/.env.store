# Store — dev usa proxy Vite (127.0.0.1); build usa dominio de producción.
VITE_BASE_PATH=/store/
VITE_API_PREFIX=storeapi
VITE_API_PORT=3003
VITE_API_HOST=127.0.0.1
VITE_API_ORIGIN=http://127.0.0.1:3003
VITE_API_MODE=local
VITE_MEDIA_PREFIX=sistema
VITE_DEV_PORT=5174
VITE_APP_NAME=Store
VITE_APP_ID=store
VITE_SUBSCRIPTIONS_ENABLED=true
